<style>:root{
  --black:#070707;
  --panel:#121009;
  --panel-2:#181510;
  --line:#2b2619;
  --gold:#D8B56A;
  --gold-soft:#E7CE97;
  --cream:#EDE7DA;
  --muted:#9C8B6E;
  --radius:2px;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit;}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
html,body{margin:0;padding:0;background:var(--black);color:var(--cream);}
body{
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  font-size:15px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,.serif{
  font-family:'Cormorant Garamond',Georgia,serif;
  font-weight:500;
  letter-spacing:0.01em;
  margin:0;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px;}
.gold{color:var(--gold);}
.rule{height:1px;background:linear-gradient(90deg,var(--gold) 0%,var(--line) 40%);}
.rule-full{height:1px;background:var(--line);}
.topnav{
  position:sticky;top:0;z-index:50;
  background:rgba(7,7,7,0.86);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
  padding-top:env(safe-area-inset-top,0px);
}
.topnav-inner{
  max-width:1180px;margin:0 auto;padding:16px 24px;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
}
.logo{font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:0.04em;color:var(--cream);display:flex;align-items:center;gap:8px;}
.logo-mark{width:30px;height:30px;border-radius:7px;display:block;flex-shrink:0;}
.logo em{font-style:normal;color:var(--gold);}
.navlinks{display:flex;gap:28px;align-items:center;}
.navlinks a{font-size:13px;letter-spacing:0.03em;color:var(--muted);transition:color .15s ease;white-space:nowrap;}
.navlinks a:hover,.navlinks a.active{color:var(--gold-soft);}
.nav-cta{
  border:1px solid var(--gold);color:var(--gold-soft);
  padding:9px 18px;font-size:12.5px;letter-spacing:0.05em;
  border-radius:var(--radius);white-space:nowrap;
  transition:background .15s ease,color .15s ease;
}
.nav-cta:hover{background:var(--gold);color:#141008;}
.nav-toggle{display:none;background:none;border:none;color:var(--cream);font-size:22px;padding:4px;}
@media (max-width:860px){
  .navlinks{
    position:fixed;inset:0 0 0 auto;width:78%;max-width:320px;
    background:var(--panel);border-left:1px solid var(--line);
    flex-direction:column;align-items:flex-start;gap:0;
    padding:88px 28px 28px;transform:translateX(100%);
    transition:transform .28s ease;
  }
  .navlinks.open{transform:translateX(0);}
  .navlinks a{padding:14px 0;width:100%;border-bottom:1px solid var(--line);font-size:15px;}
  .nav-cta{margin-top:18px;}
  .nav-toggle{display:block;}
}
.window{display:none;}
.window.active{display:block;}
.hero{
  position:relative;
  padding:64px 0 56px;
  overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;z-index:0;
  background:
    radial-gradient(ellipse 60% 50% at 82% 15%, rgba(216,181,106,0.14), transparent 60%),
    radial-gradient(ellipse 40% 40% at 100% 90%, rgba(216,181,106,0.08), transparent 60%);
}
.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1.15fr 0.85fr;gap:56px;align-items:center;}
.hero-eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:22px;}
.hero-eyebrow .ln{width:34px;height:1px;background:var(--gold);}
.hero-eyebrow span{font-size:12px;letter-spacing:0.14em;color:var(--muted);}
.hero h1{font-size:clamp(38px,6vw,64px);line-height:1.06;color:var(--cream);max-width:11ch;}
.hero h1 .accent{color:var(--gold);font-style:italic;}
.hero p{margin-top:22px;font-size:16px;color:var(--muted);max-width:42ch;line-height:1.7;}
.hero-btns{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap;}
.btn{
  padding:13px 26px;font-size:13px;letter-spacing:0.04em;border-radius:var(--radius);
  display:inline-flex;align-items:center;gap:8px;transition:all .15s ease;border:1px solid transparent;
}
.btn-gold{background:var(--gold);color:#141008;}
.btn-gold:hover{background:var(--gold-soft);}
.btn-outline{border-color:var(--line);color:var(--cream);}
.btn-outline:hover{border-color:var(--gold);color:var(--gold-soft);}
.btn-wa{border-color:#2c4a3a;color:#8fd6ad;}
.btn-wa:hover{border-color:#3f6c53;background:rgba(63,108,83,0.12);}
.hero-panel{
  position:relative;aspect-ratio:3/4;border-radius:var(--radius);
  background:
    linear-gradient(155deg, var(--panel-2), var(--black) 70%);
  border:1px solid var(--line);
  overflow:hidden;
}
.hero-panel::before{
  content:'';position:absolute;inset:0;
  background:
    repeating-linear-gradient(115deg, transparent 0 38px, rgba(216,181,106,0.045) 38px 39px),
    radial-gradient(circle at 30% 20%, rgba(216,181,106,0.16), transparent 55%);
}
.hero-panel-mark{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
}
.hero-panel-mark img{
  width:42%;max-width:210px;border-radius:22px;
  box-shadow:0 20px 60px rgba(0,0,0,0.5);
}
.hero-panel-caption{
  position:absolute;left:20px;bottom:20px;right:20px;
  font-size:11.5px;letter-spacing:0.08em;color:var(--muted);
  border-top:1px solid var(--line);padding-top:12px;
}
@media (max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:40px;}
  .hero-panel{aspect-ratio:16/10;order:-1;}
}
.section{padding:72px 0;}
.section-head{margin-bottom:40px;max-width:60ch;}
.section-eyebrow{font-size:12px;letter-spacing:0.14em;color:var(--gold);margin-bottom:10px;}
.section h2{font-size:clamp(26px,3.4vw,38px);color:var(--cream);}
.section-lead{margin-top:14px;color:var(--muted);font-size:15px;line-height:1.7;max-width:58ch;}
.about-body{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;}
.about-body p{color:var(--muted);font-size:15.5px;line-height:1.8;margin:0 0 16px;}
.about-body p:last-child{margin-bottom:0;}
@media (max-width:800px){.about-body{grid-template-columns:1fr;gap:24px;}}
.why-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
.why-card{background:var(--black);padding:30px 22px;}
.why-card .num{font-family:'Cormorant Garamond',serif;font-size:13px;color:var(--gold);margin-bottom:16px;}
.why-card h3{font-size:18px;color:var(--cream);margin-bottom:8px;line-height:1.3;}
.why-card p{font-size:13px;color:var(--muted);line-height:1.6;margin:0;}
@media (max-width:900px){.why-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:520px){.why-grid{grid-template-columns:1fr;}}
.feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.feat-card{
  border:1px solid var(--line);padding:26px 22px;background:var(--panel);
  display:flex;flex-direction:column;gap:14px;transition:border-color .15s ease;
}
.feat-card:hover{border-color:var(--gold);}
.feat-card .tag{font-size:11px;letter-spacing:0.08em;color:var(--muted);}
.feat-card h3{font-size:19px;color:var(--cream);line-height:1.3;min-height:2.6em;}
.feat-card .price{font-family:'Cormorant Garamond',serif;font-size:26px;color:var(--gold);}
.feat-card .book-link{font-size:12.5px;letter-spacing:0.05em;color:var(--gold-soft);display:flex;align-items:center;gap:6px;margin-top:auto;}
@media (max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:520px){.feat-grid{grid-template-columns:1fr;}}
.sig-row{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line);}
.sig-item{padding:26px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);}
.sig-item:last-child{border-right:none;}
.sig-item .serif{font-size:21px;color:var(--cream);}
@media (max-width:800px){.sig-row{grid-template-columns:repeat(2,1fr);}.sig-item:nth-child(2n){border-right:none;}}
.offers-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
.offer-card{background:var(--panel-2);padding:28px 24px;text-align:center;}
.offer-card .title{font-size:14px;color:var(--cream);margin-bottom:10px;}
.offer-card .detail{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:18px;color:var(--gold);}
@media (max-width:800px){.offers-strip{grid-template-columns:1fr;}}
.cta{padding:80px 0;text-align:center;position:relative;}
.cta h2{font-size:clamp(28px,4vw,44px);color:var(--cream);}
.cta-btns{display:flex;gap:14px;justify-content:center;margin-top:30px;flex-wrap:wrap;}
footer{border-top:1px solid var(--line);padding:44px 0 calc(30px + env(safe-area-inset-bottom,0px));}
.footer-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
.footer-inner .logo{font-size:18px;}
.footer-inner .logo-mark{width:24px;height:24px;border-radius:6px;}
footer .fmeta{font-size:12.5px;color:var(--muted);}
.cat-header{padding:44px 0 0;}
.cat-tabs{
  display:flex;gap:6px;overflow-x:auto;padding:28px 0 0;
  border-bottom:1px solid var(--line);
  -webkit-overflow-scrolling:touch;scrollbar-width:none;
}
.cat-tabs::-webkit-scrollbar{display:none;}
.cat-tab{
  flex:0 0 auto;padding:12px 18px;font-size:13px;letter-spacing:0.03em;color:var(--muted);
  border-bottom:2px solid transparent;white-space:nowrap;transition:color .15s ease;
}
.cat-tab.active{color:var(--gold);border-bottom-color:var(--gold);}
.cat-body{padding:40px 0 80px;}
.cat-panel{display:none;}
.cat-panel.active{display:block;}
.svc-list{display:flex;flex-direction:column;}
.svc-row{
  display:flex;justify-content:space-between;align-items:baseline;gap:20px;
  padding:18px 0;border-bottom:1px solid var(--line);
}
.svc-row .left{flex:1;min-width:0;}
.svc-row .nm{font-size:16px;color:var(--cream);}
.svc-row .freebie{display:block;font-size:12px;color:var(--gold);margin-top:4px;font-style:italic;font-family:'Cormorant Garamond',serif;}
.svc-row .right{display:flex;align-items:center;gap:16px;flex-shrink:0;}
.svc-row .price{font-family:'Cormorant Garamond',serif;font-size:19px;color:var(--gold-soft);}
.svc-row .add{
  border:1px solid var(--line);color:var(--muted);font-size:11.5px;letter-spacing:0.04em;
  padding:7px 14px;border-radius:var(--radius);transition:all .15s ease;
}
.svc-row .add:hover{border-color:var(--gold);color:var(--gold-soft);}
.area-block{margin-bottom:36px;}
.area-block:last-child{margin-bottom:0;}
.area-title{font-size:12px;letter-spacing:0.1em;color:var(--muted);text-transform:uppercase;margin-bottom:6px;padding-bottom:10px;border-bottom:1px solid var(--line);}
.booking-shell{padding:48px 0 90px;}
.steps-track{display:flex;align-items:center;gap:6px;margin-bottom:44px;flex-wrap:wrap;}
.step-pill{
  display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);
  padding:8px 14px;border:1px solid var(--line);border-radius:999px;
}
.step-pill .n{
  width:18px;height:18px;border-radius:50%;background:var(--line);color:var(--cream);
  display:flex;align-items:center;justify-content:center;font-size:10.5px;flex-shrink:0;
}
.step-pill.done{color:var(--gold-soft);border-color:var(--gold);}
.step-pill.done .n{background:var(--gold);color:#141008;}
.step-connector{width:20px;height:1px;background:var(--line);}
.book-step{display:none;}
.book-step.active{display:block;}
.book-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
.pick-card{
  border:1px solid var(--line);padding:22px 20px;background:var(--panel);cursor:pointer;
  transition:border-color .15s ease,background .15s ease;
}
.pick-card:hover{border-color:var(--gold);}
.pick-card.selected{border-color:var(--gold);background:var(--panel-2);}
.pick-card .serif{font-size:19px;color:var(--cream);margin-bottom:6px;}
.pick-card .sub{font-size:12.5px;color:var(--muted);line-height:1.5;}
@media (max-width:700px){.book-grid{grid-template-columns:1fr;}}
.form-field{margin-bottom:18px;}
.form-field label{display:block;font-size:12px;letter-spacing:0.04em;color:var(--muted);margin-bottom:8px;}
.form-field input,.form-field textarea,.form-field select{
  width:100%;background:var(--panel);border:1px solid var(--line);color:var(--cream);
  padding:12px 14px;font-size:14.5px;font-family:inherit;border-radius:var(--radius);
}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{outline:none;border-color:var(--gold);}
.form-field textarea{resize:vertical;min-height:80px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
@media (max-width:600px){.form-row{grid-template-columns:1fr;}}
.book-nav{display:flex;justify-content:space-between;margin-top:32px;gap:12px;}
.book-nav .btn-outline{background:none;}
.review-box{border:1px solid var(--line);padding:24px;background:var(--panel);margin-bottom:24px;}
.review-row{display:flex;justify-content:space-between;gap:20px;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px;}
.review-row:last-child{border-bottom:none;}
.review-row .k{color:var(--muted);}
.review-row .v{color:var(--cream);text-align:right;}
.success-box{text-align:center;padding:60px 20px;}
.success-box .mark{
  width:64px;height:64px;border-radius:50%;border:1px solid var(--gold);
  display:flex;align-items:center;justify-content:center;margin:0 auto 26px;
  font-size:26px;color:var(--gold);
}
.success-box h2{font-size:28px;color:var(--cream);margin-bottom:12px;}
.success-box p{color:var(--muted);max-width:44ch;margin:0 auto 28px;line-height:1.7;}
.home-note{
  border:1px solid var(--line);background:var(--panel-2);padding:16px 18px;
  font-size:13px;color:var(--muted);margin-top:8px;line-height:1.6;
}
</style>
</head>
