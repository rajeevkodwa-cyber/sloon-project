<!-- ================= WINDOW 1 — HOME ================= -->
<div class="window active" id="window-home">
  <div id="home-top"></div>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="wrap hero-inner">
      <div>
        <div class="hero-eyebrow"><span class="ln"></span><span>HAIR&amp;CREW SALOONS · GURUGRAM</span></div>
