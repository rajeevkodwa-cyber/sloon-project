<script>
/* ==========================================================================
   Hair&Crew — app logic (rendering + navigation + booking + WhatsApp handoff)
   ========================================================================== */

const fmt = n => '₹' + n.toLocaleString('en-IN');

/* ---------------- WhatsApp link builder ---------------- */
function waLink(number, message){
  const digits = (number || BRAND.whatsapp).replace(/[^0-9]/g, '');
  return `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
}

/* ================= WINDOW SWITCHING ================= */
function showWindow(name){
  document.querySelectorAll('.window').forEach(w => w.classList.remove('active'));
  document.getElementById('window-' + name).classList.add('active');
  document.querySelectorAll('.nav-link').forEach(a => a.classList.remove('active'));
  window.scrollTo({top:0, behavior:'instant' in window ? 'instant' : 'auto'});
  document.getElementById('navlinks').classList.remove('open');
}

document.addEventListener('click', (e) => {
  const el = e.target.closest('[data-window]');
  if(el){
    e.preventDefault();
    showWindow(el.dataset.window);
    if(el.dataset.cat){ setTimeout(()=>selectCatTab(el.dataset.cat), 0); }
    return;
  }
  const goto = e.target.closest('[data-goto]');
  if(goto){
    e.preventDefault();
    const id = goto.dataset.goto;
    showWindow('home');
    setTimeout(() => {
      const target = document.getElementById(id);
      if(target) target.scrollIntoView({behavior:'smooth', block:'start'});
    }, 30);
  }
});

document.getElementById('navToggle').addEventListener('click', (e) => {
  const open = document.getElementById('navlinks').classList.toggle('open');
  e.currentTarget.setAttribute('aria-expanded', open ? 'true' : 'false');
});

/* ================= HOME RENDER ================= */
function renderHome(){
  document.getElementById('heroSub').textContent = BRAND.subtagline;
  document.getElementById('ctaWhatsapp').href = waLink(BRAND.whatsapp, `Hi Hair&Crew Saloons, I'd like to know more about your services.`);

  const whyItems = [
    { t:'Premium Products', d:'Rica, Cirepil and other trusted names, used the way they\u2019re meant to be.' },
    { t:'Expert Beauty Professionals', d:'Trained stylists who take the time to get it right.' },
    { t:'Personalised Experience', d:'Every treatment shaped around your skin and preference.' },
    { t:'Salon & Home Service', d:'Visit us, or have Hair&Crew Saloons come to you.' },
    { t:'Hygienic & Comfortable Environment', d:'A calm, considered space for every appointment.' },
  ];
  document.getElementById('whyGrid').innerHTML = whyItems.map((w,i) => `
    <div class="why-card">
      <div class="num">${String(i+1).padStart(2,'0')}</div>
      <h3>${w.t}</h3>
      <p>${w.d}</p>
    </div>`).join('');

  document.getElementById('featGrid').innerHTML = FEATURED.map(f => `
    <div class="feat-card">
      <div class="tag">${f.note}</div>
      <h3>${f.name}</h3>
      <div class="price">${fmt(f.price)}</div>
      <a href="#" class="book-link" data-window="booking">Book now →</a>
    </div>`).join('');

  const sigItems = ['Facials','Waxing','Manicure & Pedicure','Cleanup','Massage'];
  document.getElementById('sigRow').innerHTML = sigItems.map(s => `
    <div class="sig-item"><div class="serif">${s}</div></div>`).join('');

  document.getElementById('offersStrip').innerHTML = OFFERS.map(o => `
    <div class="offer-card">
      <div class="title">${o.title}</div>
      <div class="detail">${o.detail}</div>
    </div>`).join('');
}

/* ================= CATALOG RENDER ================= */
function catPanelHTML(catId){
  if(catId === 'facials'){
    return `<div class="svc-list">${FACIALS.map(svcRowHTML).join('')}</div>`;
  }
  if(catId === 'cleanup'){
    return `<div class="svc-list">${CLEANUP.map(svcRowHTML).join('')}</div>`;
  }
  if(catId === 'waxing'){
    return WAXING.map(area => `
      <div class="area-block">
        <div class="area-title">${area.area}</div>
        <div class="svc-list">${area.options.map(svcRowHTML).join('')}</div>
      </div>`).join('');
  }
  if(catId === 'rollon'){
    return ROLLON_WAXING.map(area => `
      <div class="area-block">
        <div class="area-title">${area.area}</div>
        <div class="svc-list">${area.options.map(svcRowHTML).join('')}</div>
      </div>`).join('');
  }
  if(catId === 'manipedi'){
    return `<div class="svc-list">${MANI_PEDI.map(svcRowHTML).join('')}</div>`;
  }
  if(catId === 'bleachdetan'){
    return `<div class="svc-list">${BLEACH_DETAN_MASSAGE.map(svcRowHTML).join('')}</div>`;
  }
  return '';
}

function svcRowHTML(s){
  const payload = JSON.stringify({name:s.name, price:s.price, freebie: s.freebie || null});
  return `
    <div class="svc-row">
      <div class="left">
        <div class="nm">${s.name}</div>
        ${s.freebie ? `<span class="freebie">${s.freebie}</span>` : ''}
      </div>
      <div class="right">
        <div class="price">${fmt(s.price)}</div>
        <a href="#" class="add" data-book-item='${payload.replace(/'/g,"&#39;")}'>Add</a>
      </div>
    </div>`;
}

function renderCatalog(){
  document.getElementById('catTabs').innerHTML = CATEGORIES.map((c,i) => `
    <div class="cat-tab ${i===0?'active':''}" data-cat-tab="${c.id}">${c.label}</div>`).join('');
  document.getElementById('catBody').innerHTML = CATEGORIES.map((c,i) => `
    <div class="cat-panel ${i===0?'active':''}" id="catPanel-${c.id}">
      ${catPanelHTML(c.id)}
      <div class="book-nav"><a href="#" class="btn btn-outline" data-window="home">Back</a></div>
    </div>`).join('');
}

function selectCatTab(catId){
  document.querySelectorAll('.cat-tab').forEach(t => t.classList.toggle('active', t.dataset.catTab === catId));
  document.querySelectorAll('.cat-panel').forEach(p => p.classList.toggle('active', p.id === 'catPanel-' + catId));
}

document.addEventListener('click', (e) => {
  const tab = e.target.closest('[data-cat-tab]');
  if(tab){ e.preventDefault(); selectCatTab(tab.dataset.catTab); }
});

/* ================= BOOKING FLOW ================= */
const booking = {
  step: 1,
  category: null,
  mode: null,        // 'salon' | 'home'
  branch: null,       // branch object
  item: null,         // {name, price, freebie, type}
};

const STEP_LABELS = ['Category','Salon/Home','Branch/Address','Your details','Review'];

function stepsForFlow(){
  // dynamic step 3 label depends on mode
  const labels = [...STEP_LABELS];
  if(booking.mode === 'home') labels[2] = 'Home details';
  return labels;
}

function renderStepsTrack(){
  const labels = stepsForFlow();
  const currentIdx = mapStepToIndex(booking.step);
  document.getElementById('stepsTrack').innerHTML = labels.map((l,i) => `
    <span class="step-pill ${i < currentIdx ? 'done' : (i===currentIdx?'done':'')}"><span class="n">${i+1}</span>${l}</span>
    ${i < labels.length-1 ? '<span class="step-connector"></span>' : ''}`).join('');
}

function mapStepToIndex(step){
  // step keys: 1,2,'3s','3h',4,5,6 -> index 0..4 (6=success, treat as 4)
  const order = {1:0, 2:1, '3s':2, '3h':2, 4:3, 5:4, 6:4};
  return order[step] ?? 0;
}

function goToBookStep(step){
  booking.step = step;
  document.querySelectorAll('.book-step').forEach(s => s.classList.remove('active'));
  const idMap = {1:'bookStep1', 2:'bookStep2', '3s':'bookStep3Salon', '3h':'bookStep3Home', 4:'bookStep4', 5:'bookStep5', 6:'bookStep6'};
  document.getElementById(idMap[step]).classList.add('active');
  renderStepsTrack();
  // toggle address field visibility for home mode
  document.getElementById('fAddressWrap').style.display = booking.mode === 'home' ? 'block' : 'none';
  window.scrollTo({top: document.querySelector('.booking-shell').offsetTop - 80, behavior:'smooth'});
}

function renderBookingCategoryGrid(){
  document.getElementById('bookCategoryGrid').innerHTML = CATEGORIES.map(c => `
    <div class="pick-card" data-book-cat="${c.id}">
      <div class="serif">${c.label}</div>
      <div class="sub">View ${c.label.toLowerCase()} and choose a service.</div>
    </div>`).join('');
}

function renderBranchGrid(){
  document.getElementById('branchGrid').innerHTML = BRANCHES.map(b => `
    <div class="pick-card" data-branch="${b.id}">
      <div class="serif">${b.name}</div>
      <div class="sub">${b.address}<br>${b.phone}</div>
    </div>`).join('');
}

document.addEventListener('click', (e) => {
  // pick a category from the booking flow -> jump to catalog to choose exact item, then come back
  const bc = e.target.closest('[data-book-cat]');
  if(bc){
    e.preventDefault();
    booking.category = bc.dataset.bookCat;
    document.querySelectorAll('#bookCategoryGrid .pick-card').forEach(c => c.classList.toggle('selected', c===bc));
    showWindow('catalog');
    setTimeout(()=>selectCatTab(booking.category), 0);
    return;
  }

  // pick salon/home mode
  const modeCard = e.target.closest('#bookStep2 [data-mode]');
  if(modeCard){
    e.preventDefault();
    booking.mode = modeCard.dataset.mode;
    document.querySelectorAll('#bookStep2 .pick-card').forEach(c => c.classList.toggle('selected', c===modeCard));
    setTimeout(() => goToBookStep(booking.mode === 'salon' ? '3s' : '3h'), 150);
    return;
  }

  // pick branch
  const branchCard = e.target.closest('[data-branch]');
  if(branchCard){
    e.preventDefault();
    booking.branch = BRANCHES.find(b => b.id === branchCard.dataset.branch);
    document.querySelectorAll('#branchGrid .pick-card').forEach(c => c.classList.toggle('selected', c===branchCard));
    setTimeout(() => goToBookStep(4), 150);
    return;
  }

  // "Add" on a service row -> set item, jump to booking window step 2
  const bookItemEl = e.target.closest('[data-book-item]');
  if(bookItemEl){
    e.preventDefault();
    const data = JSON.parse(bookItemEl.dataset.bookItem);
    booking.item = data;
    showWindow('booking');
    goToBookStep(2);
    return;
  }

  // generic back/next
  const backEl = e.target.closest('[data-back]');
  if(backEl){
    e.preventDefault();
    const target = backEl.dataset.back;
    goToBookStep(isNaN(target) ? target : Number(target));
    return;
  }
  const nextEl = e.target.closest('[data-next]');
  if(nextEl){
    e.preventDefault();
    if(nextEl.dataset.next === '5'){
      if(!validateStep4()) return;
      renderReview();
    }
    goToBookStep(isNaN(nextEl.dataset.next) ? nextEl.dataset.next : Number(nextEl.dataset.next));
    return;
  }
});

document.getElementById('step4BackBtn').addEventListener('click', (e) => {
  e.preventDefault();
  goToBookStep(booking.mode === 'salon' ? '3s' : '3h');
});

function validateStep4(){
  const name = document.getElementById('fName').value.trim();
  const phone = document.getElementById('fPhone').value.trim();
  if(!name || !phone){
    alert('Please share your name and phone number so we can confirm your booking.');
    return false;
  }
  return true;
}

function renderReview(){
  const name = document.getElementById('fName').value.trim();
  const phone = document.getElementById('fPhone').value.trim();
  const address = document.getElementById('fAddress').value.trim();
  const date = document.getElementById('fDate').value;
  const time = document.getElementById('fTime').value;
  const request = document.getElementById('fRequest').value.trim();

  booking.customer = {name, phone, address, date, time, request};

  const rows = [
    ['Service', booking.item ? booking.item.name : '—'],
    ['Price', booking.item ? fmt(booking.item.price) : '—'],
    ['Salon / Home', booking.mode === 'salon' ? 'Salon Service' : 'Home Service'],
  ];
  if(booking.mode === 'salon' && booking.branch){
    rows.push(['Branch', booking.branch.name]);
  }
  if(booking.mode === 'home' && address){
    rows.push(['Address', address]);
  }
  rows.push(['Name', name || '—']);
  rows.push(['Phone', phone || '—']);
  rows.push(['Date', date || '—']);
  rows.push(['Time', time || '—']);
  if(request) rows.push(['Special request', request]);
  if(booking.item && booking.item.freebie) rows.push(['Complimentary', booking.item.freebie]);

  document.getElementById('reviewBox').innerHTML = rows.map(([k,v]) => `
    <div class="review-row"><span class="k">${k}</span><span class="v">${v}</span></div>`).join('');
}

function buildWhatsAppMessage({item, mode, branch, name, phone, address, date, time, request}){
  const lines = [
    'Hair&Crew Saloons Booking',
    '',
    `Customer Name: ${name || '—'}`,
    `Phone: ${phone || '—'}`,
    `Service: ${item ? item.name : '—'}`,
    `Price: ${item ? fmt(item.price) : '—'}`,
    `Salon / Home Service: ${mode === 'home' ? 'Home Service' : (mode === 'salon' ? 'Salon Service' : '—')}`,
  ];
  if(mode === 'salon' && branch) lines.push(`Branch: ${branch.name}`);
  if(mode === 'home') lines.push(`Address: ${address || '—'}`);
  lines.push(`Date: ${date || '—'}`);
  lines.push(`Time: ${time || '—'}`);
  lines.push(`Special Request: ${request || '—'}`);
  if(item && item.freebie) lines.push('', item.freebie);
  lines.push('', 'Please confirm my appointment.');
  return lines.join('\n');
}

document.getElementById('confirmBtn').addEventListener('click', (e) => {
  e.preventDefault();
  const c = booking.customer || {};
  const msg = buildWhatsAppMessage({
    item: booking.item, mode: booking.mode, branch: booking.branch,
    name: c.name, phone: c.phone, address: c.address, date: c.date, time: c.time, request: c.request,
  });
  const number = (booking.mode === 'salon' && booking.branch && booking.branch.whatsapp) ? booking.branch.whatsapp : BRAND.whatsapp;
  window.open(waLink(number, msg), '_blank', 'noopener');
  goToBookStep(6);
});

/* ================= INIT ================= */
renderHome();
renderCatalog();
renderBookingCategoryGrid();
renderBranchGrid();
renderStepsTrack();

</script>
